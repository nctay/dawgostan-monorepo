{
  "name": "@dawgostan/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./telegram-fetch": {
      "types": "./src/telegram-fetch.ts",
      "import": "./dist/telegram-fetch.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0",
    "node-fetch": "2.7.0"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.13",
    "vitest": "^3.2.4"
  }
}
